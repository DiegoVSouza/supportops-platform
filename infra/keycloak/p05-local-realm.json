{
  "realm": "p05-local",
  "enabled": true,
  "sslRequired": "none",
  "verifyEmail": false,
  "loginWithEmailAllowed": false,
  "roles": {
    "realm": [
      { "name": "agent", "description": "Disposable local test role" }
    ]
  },
  "clientScopes": [
    {
      "name": "billing:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    }
  ],
  "clients": [
    {
      "clientId": "p05-resource",
      "name": "P05 disposable local resource server",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "p05-local-resource-secret-only",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "optionalClientScopes": ["billing:read"],
      "protocolMappers": [
        {
          "name": "P05 audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "p05-resource",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "P05 tenant claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "P05 role claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "user.realmRole": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "agent-a",
      "enabled": true,
      "firstName": "Local",
      "lastName": "Agent",
      "email": "agent-a@example.test",
      "emailVerified": true,
      "requiredActions": [],
      "attributes": { "tenant_id": ["tenant-a"] },
      "credentials": [
        { "type": "password", "value": "p05-test-password-only", "temporary": false }
      ],
      "realmRoles": ["agent"]
    }
  ]
}
